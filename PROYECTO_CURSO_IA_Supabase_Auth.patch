diff --git a/supabase/migrations/202610280000_base_agricola.sql b/supabase/migrations/202610280000_base_agricola.sql
new file mode 100644
index 0000000..076cafb
--- /dev/null
+++ b/supabase/migrations/202610280000_base_agricola.sql
@@ -0,0 +1,64 @@
+-- Base agrícola existente adaptada a migraciones de Supabase.
+-- Nuevo proyecto independiente de IA; conserva tablas y estados agrícolas.
+begin;
+-- Supabase schema for the three-role agroexport workflow.
+create extension if not exists pgcrypto;
+
+do $$ begin
+  create type public.user_role as enum ('OPERADOR', 'SUPERVISOR', 'ADMIN');
+exception when duplicate_object then null; end $$;
+
+do $$ begin
+  create type public.lote_estado as enum ('EN_CAMPO', 'EN_PACKING', 'PENDIENTE_FIRMA', 'APROBADO', 'RECHAZADO');
+exception when duplicate_object then null; end $$;
+
+create table if not exists public.usuarios (
+  id uuid primary key references auth.users(id) on delete cascade,
+  email text not null unique,
+  rol public.user_role not null default 'OPERADOR',
+  nombre text not null,
+  created_at timestamptz not null default now()
+);
+
+create table if not exists public.lotes (
+  id uuid primary key default gen_random_uuid(),
+  fundo text not null,
+  cultivo text not null,
+  agroquimico text not null,
+  ppm numeric(10, 3) not null check (ppm >= 0),
+  dias_transcurridos integer not null default 0 check (dias_transcurridos >= 0),
+  dias_carencia integer not null default 0 check (dias_carencia >= 0),
+  fecha_cosecha date not null default current_date,
+  estado public.lote_estado not null default 'EN_CAMPO',
+  destino text,
+  creado_por uuid not null references public.usuarios(id),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+alter table public.lotes
+  add column if not exists dias_transcurridos integer not null default 0 check (dias_transcurridos >= 0),
+  add column if not exists fecha_cosecha date not null default current_date;
+
+create table if not exists public.documentos (
+  id uuid primary key default gen_random_uuid(),
+  lote_id uuid not null references public.lotes(id) on delete cascade,
+  tipo_documento text not null check (tipo_documento in ('GUIA_REMISION', 'CERTIFICADO_EMPAQUE', 'CERTIFICADO_FITOSANITARIO')),
+  url_archivo text not null,
+  created_at timestamptz not null default now()
+);
+
+alter table public.usuarios enable row level security;
+alter table public.lotes enable row level security;
+alter table public.documentos enable row level security;
+
+
+-- No client mutation is granted by the base schema. Apply both following migrations.
+do $$ begin
+  if exists(select 1 from pg_publication where pubname='supabase_realtime')
+     and not exists(select 1 from pg_publication_tables where pubname='supabase_realtime' and schemaname='public' and tablename='lotes') then
+    alter publication supabase_realtime add table public.lotes;
+  end if;
+end $$;
+
+commit;
diff --git a/supabase/migrations/202610280001_auth_don_ricardo.sql b/supabase/migrations/202610280001_auth_don_ricardo.sql
new file mode 100644
index 0000000..04c000a
--- /dev/null
+++ b/supabase/migrations/202610280001_auth_don_ricardo.sql
@@ -0,0 +1,75 @@
+-- Apply ONLY to the independent Supabase project for Agrícola Don Ricardo.
+-- Existing business tables and data are not deleted or copied from Big Data.
+begin;
+create extension if not exists pgcrypto;
+do $$ begin
+  create type public.user_role as enum ('OPERADOR', 'SUPERVISOR', 'ADMIN');
+exception when duplicate_object then null; end $$;
+
+-- Stop instead of attempting to overwrite the incompatible historical Neon schema.
+do $$ begin
+  if exists (select 1 from information_schema.columns where table_schema='public' and table_name='usuarios' and column_name='hash_password') then
+    raise exception 'Esquema Neon detectado. Use un proyecto Supabase independiente o prepare una migración revisada; no mezcle credenciales.';
+  end if;
+end $$;
+create table if not exists public.usuarios (
+  id uuid primary key references auth.users(id) on delete cascade,
+  email text not null unique,
+  rol public.user_role not null default 'OPERADOR',
+  nombre text not null,
+  is_active boolean not null default false,
+  created_at timestamptz not null default now()
+);
+alter table public.usuarios add column if not exists is_active boolean not null default false;
+create unique index if not exists usuarios_email_lower_idx on public.usuarios(lower(email));
+
+create or replace function public.handle_don_ricardo_signup()
+returns trigger language plpgsql security definer set search_path = '' as $$
+begin
+  if new.email is null then raise exception 'email_required'; end if;
+  insert into public.usuarios(id, email, nombre, rol, is_active)
+  values(new.id, lower(new.email), left(coalesce(nullif(trim(new.raw_user_meta_data->>'nombre'),''), nullif(trim(new.raw_user_meta_data->>'full_name'),''), split_part(new.email,'@',1)),120), 'OPERADOR', false);
+  return new;
+end $$;
+drop trigger if exists on_don_ricardo_user_created on auth.users;
+create trigger on_don_ricardo_user_created after insert on auth.users
+for each row execute function public.handle_don_ricardo_signup();
+
+-- Accounts created before the trigger get a pending profile, never an elevated role.
+insert into public.usuarios(id,email,nombre,rol,is_active)
+select id,lower(email),left(coalesce(nullif(trim(raw_user_meta_data->>'nombre'),''),nullif(trim(raw_user_meta_data->>'full_name'),''),split_part(email,'@',1)),120),'OPERADOR',false
+from auth.users where email is not null
+on conflict(id) do nothing;
+
+create or replace function public.sync_don_ricardo_email()
+returns trigger language plpgsql security definer set search_path = '' as $$
+begin
+  if new.email is not null and new.email is distinct from old.email then
+    update public.usuarios set email=lower(new.email) where id=new.id;
+  end if;
+  return new;
+end $$;
+drop trigger if exists on_don_ricardo_email_changed on auth.users;
+create trigger on_don_ricardo_email_changed after update of email on auth.users
+for each row execute function public.sync_don_ricardo_email();
+
+create or replace function public.don_ricardo_role()
+returns text language sql stable security definer set search_path = '' as $$
+  select u.rol::text from public.usuarios u join auth.users a on a.id=u.id
+  where u.id=(select auth.uid()) and u.is_active and a.email_confirmed_at is not null
+$$;
+
+alter table public.usuarios enable row level security;
+-- Replace only this project's documented profile policies. No self-service role updates.
+drop policy if exists "users can read own profile" on public.usuarios;
+drop policy if exists usuarios_read_authorized on public.usuarios;
+create policy usuarios_read_authorized on public.usuarios for select to authenticated
+using(id=(select auth.uid()) or (select public.don_ricardo_role())='ADMIN');
+revoke all on public.usuarios from public, anon, authenticated;
+grant usage on schema public to authenticated;
+grant select on public.usuarios to authenticated;
+revoke all on function public.handle_don_ricardo_signup() from public,anon,authenticated;
+revoke all on function public.sync_don_ricardo_email() from public,anon,authenticated;
+revoke all on function public.don_ricardo_role() from public,anon,authenticated;
+grant execute on function public.don_ricardo_role() to authenticated;
+commit;
diff --git a/supabase/migrations/202610280002_workflow_access.sql b/supabase/migrations/202610280002_workflow_access.sql
new file mode 100644
index 0000000..8537a97
--- /dev/null
+++ b/supabase/migrations/202610280002_workflow_access.sql
@@ -0,0 +1,33 @@
+-- Apply after database/supabase-schema.sql and the auth migration.
+-- These policies preserve Campo/Packing/Gerencia and require active, confirmed accounts.
+begin;
+drop policy if exists "authenticated users can read workflow" on public.lotes;
+drop policy if exists "operators create field lots" on public.lotes;
+drop policy if exists "packing and admin update lots" on public.lotes;
+drop policy if exists "authenticated users manage documents" on public.documentos;
+
+create policy lotes_read_active on public.lotes for select to authenticated using (
+  (select public.don_ricardo_role()) in ('SUPERVISOR','ADMIN')
+  or ((select public.don_ricardo_role())='OPERADOR' and creado_por=(select auth.uid()))
+);
+create policy lotes_insert_operator on public.lotes for insert to authenticated with check (
+  (select public.don_ricardo_role())='OPERADOR' and creado_por=(select auth.uid()) and estado='EN_CAMPO'
+);
+create policy lotes_update_packing_management on public.lotes for update to authenticated
+using ((select public.don_ricardo_role()) in ('SUPERVISOR','ADMIN'))
+with check ((select public.don_ricardo_role()) in ('SUPERVISOR','ADMIN'));
+create policy documentos_read_visible on public.documentos for select to authenticated using (
+  exists(select 1 from public.lotes l where l.id=lote_id)
+);
+create policy documentos_insert_active on public.documentos for insert to authenticated with check (
+  (select public.don_ricardo_role()) in ('OPERADOR','SUPERVISOR','ADMIN')
+  and exists(select 1 from public.lotes l where l.id=lote_id)
+);
+create policy documentos_delete_active on public.documentos for delete to authenticated using (
+  (select public.don_ricardo_role()) in ('OPERADOR','SUPERVISOR','ADMIN')
+  and exists(select 1 from public.lotes l where l.id=lote_id)
+);
+revoke all on public.lotes,public.documentos from public,anon,authenticated;
+grant select,insert,update on public.lotes to authenticated;
+grant select,insert,delete on public.documentos to authenticated;
+commit;
