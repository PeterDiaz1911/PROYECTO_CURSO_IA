+++ b/src/features/auth/AuthGate.tsx
@@ -0,0 +1,24 @@
+"use client";
+import { useEffect } from "react";
+import { usePathname, useRouter } from "next/navigation";
+import { useAuth } from "./AuthProvider";
+import { roleHome, routeRole } from "./roles";
+
+export function SessionStatus({ children }: { children: React.ReactNode }) {
+  return <main className="flex min-h-screen items-center justify-center bg-stone-50 p-6"><section className="w-full max-w-md rounded-2xl border border-green-900/10 bg-white p-8 shadow-sm">{children}</section></main>;
+}
+export function AuthGate({ children }: { children: React.ReactNode }) {
+  const { client, session, profile, loading, error, reload, signOut, recovery } = useAuth();
+  const path = usePathname(); const router = useRouter();
+  const expected = routeRole(path);
+  useEffect(() => {
+    if (loading) return;
+    if (!session || recovery) router.replace("/login");
+    else if (profile?.is_active && expected && profile.rol !== expected) router.replace(roleHome[profile.rol]);
+  }, [loading, session, recovery, profile, expected, router]);
+  if (!client) return <SessionStatus><h1 className="text-xl font-bold">Configura el Supabase de Agrícola Don Ricardo</h1><p className="mt-3 text-sm text-gray-600">Faltan las variables públicas del proyecto independiente de IA.</p></SessionStatus>;
+  if (loading || !session || recovery) return <SessionStatus><p role="status">Comprobando tu acceso...</p></SessionStatus>;
+  if (error || !profile || !profile.is_active) return <SessionStatus><h1 className="text-xl font-bold">{profile && !profile.is_active ? "Cuenta pendiente de habilitación" : "Perfil no disponible"}</h1><p className="mt-3 text-sm text-gray-600">{error || "Gerencia debe habilitar tu cuenta y asignarte un área antes de operar."}</p><div className="mt-6 flex gap-4"><button className="font-bold text-green-900" onClick={reload}>Revisar acceso</button><button onClick={() => void signOut().catch(() => alert("No se pudo cerrar sesión. Inténtalo nuevamente."))}>Cerrar sesión</button></div></SessionStatus>;
+  if (expected && profile.rol !== expected) return <SessionStatus><p role="status">Abriendo tu área de trabajo...</p></SessionStatus>;
+  return children;
+}
diff --git a/src/features/auth/AuthProvider.tsx b/src/features/auth/AuthProvider.tsx
new file mode 100644
index 0000000..a4457a7
--- /dev/null
+++ b/src/features/auth/AuthProvider.tsx
@@ -0,0 +1,77 @@
+"use client";
+import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from "react";
+import type { Session } from "@supabase/supabase-js";
+import { getSupabaseBrowserClient } from "@/lib/supabase/client";
+import { useTraceabilityStore } from "@/store/useTraceabilityStore";
+import { isUserRole, type UserProfile } from "./roles";
+
+type AuthContextValue = {
+  client: ReturnType<typeof getSupabaseBrowserClient>;
+  session: Session | null; profile: UserProfile | null; loading: boolean; error: string;
+  recovery: boolean; clearRecovery: () => void; reload: () => void;
+  signOut: () => Promise<void>;
+};
+const Context = createContext<AuthContextValue | null>(null);
+export function AuthProvider({ children }: { children: React.ReactNode }) {
+  const client = useMemo(getSupabaseBrowserClient, []);
+  const [session, setSession] = useState<Session | null>(null);
+  const [profile, setProfile] = useState<UserProfile | null>(null);
+  const [loading, setLoading] = useState(Boolean(client));
+  const [error, setError] = useState("");
+  const [recovery, setRecovery] = useState(false);
+  const [retry, setRetry] = useState(0);
+  const generation = useRef(0);
+  const signOut = useCallback(async () => {
+    if (!client) return;
+    const { error: requestError } = await client.auth.signOut();
+    if (requestError) throw requestError;
+    useTraceabilityStore.getState().clearStore();
+    localStorage.removeItem("nativa-auth");
+    document.cookie = "nativa-role=; Path=/; Max-Age=0; SameSite=Lax";
+    setRecovery(false);
+  }, [client]);
+  useEffect(() => {
+    if (!client) return;
+    let active = true;
+    let currentUser: string | null = null;
+    let authEvents = 0;
+    async function loadProfile(nextSession: Session | null, force = false) {
+      if (!active) return;
+      setSession(nextSession);
+      const id = nextSession?.user.id ?? null;
+      if (!force && id && id === currentUser) return;
+      currentUser = id;
+      const request = ++generation.current;
+      setProfile(null); setError("");
+      useTraceabilityStore.getState().clearStore();
+      if (!id) { setLoading(false); return; }
+      setLoading(true);
+      try {
+        const { data, error: requestError } = await client!.from("usuarios").select("id, nombre, email, rol, is_active").eq("id", id).maybeSingle();
+        if (!active || request !== generation.current) return;
+        if (requestError) throw new Error(requestError.message);
+        if (!data || !isUserRole(data.rol)) throw new Error("Tu cuenta aún no tiene un perfil válido. Contacta a Gerencia.");
+        setProfile(data as UserProfile);
+      } catch (cause) {
+        if (active && request === generation.current) setError(cause instanceof Error ? cause.message : "No se pudo cargar tu perfil.");
+      } finally { if (active && request === generation.current) setLoading(false); }
+    }
+    const { data: listener } = client.auth.onAuthStateChange((event, nextSession) => {
+      if (!active) return;
+      authEvents += 1;
+      if (event === "PASSWORD_RECOVERY") setRecovery(true);
+      // Supabase callbacks must return before making another Auth request.
+      setTimeout(() => { if (active) void loadProfile(nextSession); }, 0);
+    });
+    const startupEvents = authEvents;
+    void client.auth.getSession().then(({ data, error: sessionError }) => {
+      if (!active || authEvents !== startupEvents) return;
+      if (sessionError) { setError(sessionError.message); setLoading(false); return; }
+      void loadProfile(data.session, true);
+    }).catch(() => { if (active) { setError("No se pudo restaurar la sesión."); setLoading(false); } });
+    return () => { active = false; listener.subscription.unsubscribe(); };
+  }, [client, retry]);
+  const value = { client, session, profile, loading, error, recovery, clearRecovery: () => setRecovery(false), reload: () => setRetry((value) => value + 1), signOut };
+  return <Context.Provider value={value}>{children}</Context.Provider>;
+}
+export function useAuth() { const context = useContext(Context); if (!context) throw new Error("AuthProvider no está montado."); return context; }
