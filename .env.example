# Create a NEW Supabase project for Agrícola Don Ricardo / PROYECTO_CURSO_IA.
# Copy to .env.local in the repository root. Never reuse the Big Data database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after configuring Google OAuth in this separate Supabase project.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# For the Pages build only; next.config sets the frontend base path.
# DEPLOY_TARGET=github-pages
# No service_role, database password or LLM secret belongs in NEXT_PUBLIC_*.
